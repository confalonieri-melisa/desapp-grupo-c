DATABASE_URL="postgresql://postgres:postgres@localhost:5433/desapp_db"
JWT_SECRET="secret-jwt-key-desapp-grupo-c-min-32-chars"
NODE_ENV="development"
PORT=3000

# WhoScored synchronization.
# Install the Python dependency with: pip install -r requirements-scraper.txt
# WHOSCORED_PYTHON_PATH="python"
# WHOSCORED_SCRIPT_PATH="scripts/whoscored_scraper.py"
# WHOSCORED_URL="https://www.whoscored.com/Statistics"
# WHOSCORED_MAX_PAGES=100
# WHOSCORED_LIMIT=50
# WHOSCORED_HEADLESS=false
FOOTBALL_DATA_BASE_URL=https://api.football-data.org
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_TIMEOUT_MS=10000
FOOTBALL_DATA_MAX_RETRIES=2
CURRENT_MARKET_SEASON=2026

# Worker batch: ambos procesos arrancan semanales, martes, en hora local.
# La web y el worker deben compartir DATABASE_URL. Reiniciar el worker al cambiar horarios.
BATCH_SYNC_WEEKDAY=2
BATCH_SYNC_TIME=18:00
BATCH_SYNC_TIMEZONE=America/Argentina/Buenos_Aires
BATCH_RECALC_WEEKDAY=2
BATCH_RECALC_TIME=18:15
BATCH_RECALC_TIMEZONE=America/Argentina/Buenos_Aires
BATCH_POLL_SECONDS=15
